#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python="$root/.venv/bin/python"

if [ ! -x "$python" ]; then
    printf '%s\n' 'Missing .venv/bin/python. From the checkout root, run:' \
        '  python3 -m venv .venv' \
        '  .venv/bin/python -m pip install -r requirements.txt' >&2
    exit 2
fi

exec "$python" -B "$root/exercise.py" "$@"
